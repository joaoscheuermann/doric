{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "direct-benchmark",
  "projectType": "application",
  "sourceRoot": "benchmarks/direct/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "build",
          "projects": ["benchmark-harness"]
        }
      ],
      "options": {
        "command": "node --check benchmarks/direct/src/index.mjs"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "command": "node --env-file-if-exists=.env --conditions=@org/source --import @swc-node/register/esm-register benchmarks/direct/src/index.mjs",
        "forwardAllArgs": true
      }
    }
  },
  "tags": ["benchmark", "private"]
}
