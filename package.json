{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:test": "node --test tests/lint.test.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "doric:spawn-agent": "node scripts/spawn-agent.mjs",
    "codex:oauth": "node --conditions=@org/source --import @swc-node/register/esm-register scripts/codex-oauth.mjs",
    "okf": "node --conditions=@org/source --import @swc-node/register/esm-register scripts/okf.mjs",
    "doric:dev": "concurrently --kill-others --success first --names renderer,electron \"npm run nxe:serve:frontend\" \"wait-on tcp:127.0.0.1:4200 && npm run nxe:serve:backend\"",
    "nxe:build:frontend": "nx build doric-renderer",
    "nxe:build:backend": "nx build doric-app",
    "nxe:serve:frontend": "nx serve doric-renderer",
    "nxe:serve:backend": "nx serve doric-app",
    "nxe:package:app": "nx run doric-app:package",
    "nxe:make:app": "nx run doric-app:make"
  },
  "private": true,
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^10.0.1",
    "@nx/eslint": "^22.6.5",
    "@nx/js": "^22.6.5",
    "@nx/react": "22.6.5",
    "@nx/web": "22.6.5",
    "@nx/webpack": "22.6.5",
    "@nxlv/python": "^22.2.2",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.7",
    "@svgr/webpack": "^8.0.1",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "10.0.5",
    "electron": "44.4.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "nx": "22.6.5",
    "nx-electron": "22.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "react-refresh": "^0.10.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.0",
    "wait-on": "9.1.0",
    "webpack-cli": "^5.1.4"
  },
  "workspaces": [
    "bundles/*",
    "agents/*",
    "packages/*",
    "tools/*",
    "workflows/*",
    "benchmarks/*",
    "app/*"
  ]
}
