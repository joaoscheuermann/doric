{
  "name": "bundle",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "@org/source": "./src/contracts/index.ts",
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "default": "./dist/contracts/index.js"
    },
    "./runtime": {
      "@org/source": "./src/runtime/index.ts",
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./externals": {
      "@org/source": "./src/build/externals.ts",
      "types": "./dist/build/externals.d.ts",
      "import": "./dist/build/externals.js",
      "default": "./dist/build/externals.js"
    },
    "./testing": {
      "@org/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./schemas/*": "./dist/schemas/*"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "tslib": "^2.3.0",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  }
}
