{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "storage",
  "projectType": "library",
  "sourceRoot": "packages/storage/src",
  "targets": {
    "generate-proto": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/buf.yaml",
        "{workspaceRoot}/buf.lock",
        "{workspaceRoot}/buf.gen.yaml",
        "{projectRoot}/proto/**/*.proto",
        {
          "externalDependencies": ["@bufbuild/buf", "@bufbuild/protoc-gen-es"]
        }
      ],
      "outputs": ["{projectRoot}/src/contracts/gen"],
      "options": {
        "commands": [
          "npx buf generate --template buf.gen.yaml --path packages/storage/proto/doric -o packages/storage"
        ],
        "parallel": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-proto", "^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsc --build packages/storage/tsconfig.lib.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-proto", "^build"],
      "options": {
        "command": "tsc --build packages/storage/tsconfig.json --emitDeclarationOnly"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-proto", "^build", "build", "sqlite:compile"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "tsc -p packages/storage/tsconfig.spec.json",
          "find packages/storage/dist-tests/tests -maxdepth 1 -name '*.test.js' ! -name kv-heavy.test.js -exec node --test {} +"
        ],
        "parallel": false
      }
    },
    "test-heavy": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "build", "sqlite:compile"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "tsc -p packages/storage/tsconfig.spec.json",
          "node --test --test-timeout=1800000 packages/storage/dist-tests/tests/kv-heavy.test.js"
        ],
        "parallel": false
      }
    },
    "bench-rk27": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["generate-proto", "^build", "build"],
      "options": {
        "commands": [
          "npx nx run sqlite:compile:production",
          "tsc -p packages/storage/tsconfig.spec.json",
          "node packages/storage/dist-tests/tests/bench/rk27.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": []
}
