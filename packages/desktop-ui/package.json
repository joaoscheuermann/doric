{
  "name": "desktop-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/styles/theme.css",
    "./tailwind.css": "./src/styles/tailwind.css",
    "./tokens.json": "./dist/tokens.json",
    "./tokens": {
      "@org/source": "./src/tokens/tokens.ts",
      "types": "./dist/tokens/tokens.d.ts",
      "import": "./dist/tokens/tokens.js",
      "default": "./dist/tokens/tokens.js"
    },
    "./chrome-bar": {
      "@org/source": "./src/chrome-bar.tsx",
      "types": "./dist/chrome-bar.d.ts",
      "import": "./dist/chrome-bar.js",
      "default": "./dist/chrome-bar.js"
    },
    "./react-element": {
      "@org/source": "./src/react-element.ts",
      "types": "./dist/react-element.d.ts",
      "import": "./dist/react-element.js",
      "default": "./dist/react-element.js"
    },
    "./utils": {
      "@org/source": "./src/lib/utils.ts",
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js",
      "default": "./dist/lib/utils.js"
    },
    "./cmdk": {
      "@org/source": "./src/cmdk.ts",
      "types": "./dist/cmdk.d.ts",
      "import": "./dist/cmdk.js",
      "default": "./dist/cmdk.js"
    },
    "./*": {
      "@org/source": "./src/components/*.tsx",
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "bundle": "0.0.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^0.544.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.13.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "happy-dom": "20.8.9"
  }
}
