{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "desktop-client",
  "projectType": "library",
  "sourceRoot": "packages/desktop-client/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsc --build packages/desktop-client/tsconfig.lib.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc --build packages/desktop-client/tsconfig.json --emitDeclarationOnly"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "tsc -p packages/desktop-client/tsconfig.spec.json",
          "node --test packages/desktop-client/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": []
}
