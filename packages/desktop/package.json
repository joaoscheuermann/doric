      "import": "./dist/panels/index.js",
      "default": "./dist/panels/index.js"
    },
    "./ui/code": {
      "@org/source": "./src/code/index.ts",
      "types": "./dist/code/index.d.ts",
      "import": "./dist/code/index.js",
