      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "@org/source": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./protocol": {
      "@org/source": "./src/client/protocol.ts",
      "types": "./dist/client/protocol.d.ts",
      "import": "./dist/client/protocol.js",
      "default": "./dist/client/protocol.js"
    },
    "./reads": {
      "@org/source": "./src/reads/index.ts",
      "types": "./dist/reads/index.d.ts",
      "import": "./dist/reads/index.js",
      "default": "./dist/reads/index.js"
    },
    "./ui": {
