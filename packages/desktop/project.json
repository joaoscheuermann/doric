{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "desktop",
  "projectType": "library",
  "sourceRoot": "packages/desktop/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "tsc --build packages/desktop/tsconfig.lib.json",
          "node packages/desktop/scripts/build-tokens.mjs"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc --build packages/desktop/tsconfig.json --emitDeclarationOnly"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "tsc -p packages/desktop/tsconfig.spec.json",
          "node packages/desktop/scripts/verify-provenance.mjs",
          "node --test packages/desktop/dist-tests/tests/*.test.js packages/desktop/dist-tests/tests/client/*.test.js packages/desktop/dist-tests/tests/reads/*.test.js packages/desktop/dist-tests/tests/canvas/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": []
}
