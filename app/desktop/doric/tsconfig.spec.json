{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "outDir": "dist-tests",
    "rootDir": ".",
    "tsBuildInfoFile": "dist-tests/tsconfig.spec.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "src/connection/**/*.ts",
    "src/platform/**/*.ts",
    "src/app/api/desktop.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "src/platform/generation/runner-bootstrap.ts",
    "src/platform/generation/runner-entry.ts"
  ]
}
