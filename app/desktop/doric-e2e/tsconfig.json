{
  "extends": "../doric/tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "outDir": "dist-tests",
    "rootDir": "..",
    "tsBuildInfoFile": "dist-tests/tsconfig.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "../doric/src/connection/**/*.ts",
    "../doric/src/platform/**/*.ts",
    "../doric/src/app/api/desktop.ts",
    "../doric/tests/support/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "../doric/src/platform/generation/runner-bootstrap.ts",
    "../doric/src/platform/generation/runner-entry.ts"
  ],
  "references": [
    {
      "path": "../../../packages/bundle"
    },
    {
      "path": "../../../packages/desktop"
    },
    {
      "path": "../doric"
    }
  ]
}
