{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "rootDir": "src",
    "tsBuildInfoFile": "../../dist/out-tsc/doric.tsbuildinfo",
    "types": ["node"]
  },
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "src/splash-page/**",
    "src/platform/generation/runner-bootstrap.ts",
    "src/platform/generation/runner-entry.ts",
    "src/workspace/**",
    "src/notifications.ts",
    "src/connection/ipc.ts",
    "src/app/api/terminals.ts"
  ],
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../packages/bundle/tsconfig.lib.json"
    },
    {
      "path": "../../packages/desktop-client/tsconfig.lib.json"
    },
    {
      "path": "../../packages/desktop-ui/tsconfig.lib.json"
    }
  ]
}
