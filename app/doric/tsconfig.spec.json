{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "outDir": "dist-tests",
    "rootDir": ".",
    "tsBuildInfoFile": "dist-tests/tsconfig.spec.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "src/connection/**/*.ts",
    "src/platform/**/*.ts",
    "src/app/api/desktop.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "src/platform/generation/runner-bootstrap.ts",
    "src/platform/generation/runner-entry.ts",
    "src/connection/ipc.ts",
    "tests/config-boundary.test.ts",
    "tests/project-events.test.ts",
    "tests/terminal-events.test.ts",
    "tests/thread-events.test.ts",
    "tests/thread-history.test.ts",
    "tests/workspace-boundary.test.ts"
  ]
}
