{
  "name": "doric-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "app/doric/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx-electron:build",
      "outputs": [
        "{options.outputPath}/main.js",
        "{options.outputPath}/main.js.map",
        "{options.outputPath}/preload.js",
        "{options.outputPath}/preload.js.map",
        "{options.outputPath}/package.json",
        "{options.outputPath}/3rdpartylicenses.txt",
        "{options.outputPath}/assets/legacy-origin.html"
      ],
      "options": {
        "outputPath": "dist/app/doric",
        "main": "app/doric/src/main.ts",
        "tsConfig": "app/doric/tsconfig.app.json",
        "assets": ["app/doric/src/assets"],
        "externalDependencies": ["socket.io-client"],
        "webpackConfig": "app/doric/webpack.config.js"
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "inspect": false
        }
      },
      "dependsOn": ["^build", "doric-platform:build", "build-runner"]
    },
    "build-runner": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "doric-platform:build"],
      "inputs": [
        "{projectRoot}/build-runner.mjs",
        "{projectRoot}/src/**/*",
        "^production",
        {
          "env": "NODE_ENV"
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/app/doric/assets/generation-runner.mjs",
        "{workspaceRoot}/dist/app/doric/assets/generation-runner-main.mjs",
        "{workspaceRoot}/dist/app/doric/assets/generation-contracts.mjs",
        "{workspaceRoot}/dist/app/doric/assets/generation-chunks",
        "{workspaceRoot}/dist/app/doric/assets/platform/splash@1.0.0"
      ],
      "options": {
        "command": "node app/doric/build-runner.mjs --out dist/app/doric/assets"
      }
    },
    "serve": {
      "executor": "nx-electron:execute",
      "options": {
        "buildTarget": "doric-app:build"
      }
    },
    "package": {
      "executor": "nx-electron:package",
      "options": {
        "name": "doric",
        "frontendProject": "doric-renderer",
        "sourcePath": "dist/app",
        "outputPath": "dist/packages",
        "prepackageOnly": true
      }
    },
    "make": {
      "executor": "nx-electron:make",
      "options": {
        "name": "doric",
        "frontendProject": "doric-renderer",
        "sourcePath": "dist/app",
        "outputPath": "dist/executables"
      }
    },
    "lint": {
      "command": "biome check app/doric --formatter-enabled=false"
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "rm -rf app/doric/dist-tests/tests app/doric/dist-tests/src",
          "tsc -p app/doric/tsconfig.spec.json",
          "node --test app/doric/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      },
      "dependsOn": ["^build"]
    },
    "test-electron": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "bundle-core:build"],
      "outputs": ["{projectRoot}/dist-tests/electron"],
      "options": {
        "commands": [
          "tsc -p app/doric/tsconfig.electron.json",
          "electron app/doric/dist-tests/electron/tests-electron/run.js"
        ],
        "parallel": false
      }
    }
  }
}
