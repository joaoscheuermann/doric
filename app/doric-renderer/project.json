{
  "name": "doric-renderer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "app/doric-renderer/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project doric-renderer --web",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "tsc -p app/doric-renderer/tsconfig.spec.json",
          "node --test app/doric-renderer/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    }
  }
}
