    "src/domain/workspace.ts",
    "src/doric.d.ts",
    "src/domain/delegated.ts",
    "src/domain/files.ts",
    "src/domain/projector.ts",
    "src/domain/selection.ts",
    "src/domain/settings-search.ts",
    "src/utility/activity-summary.ts",
    "src/utility/contrast.ts",
    "src/utility/humanize.ts",
    "src/utility/identicon.ts",
    "src/utility/prompt-signal.ts",
