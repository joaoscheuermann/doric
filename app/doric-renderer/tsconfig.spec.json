{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist-tests",
    "rootDir": ".",
    "tsBuildInfoFile": "dist-tests/tsconfig.spec.tsbuildinfo",
    "types": ["node"]
  },
  "exclude": [],
  "include": [
    "src/app/connection.ts",
    "src/app/workspace.ts",
    "src/doric.d.ts",
    "src/chat/delegated.ts",
    "src/chat/editing.ts",
    "src/chat/projector.ts",
    "src/chat/reveal.ts",
    "src/chat/shortcuts.ts",
    "src/chat/tabs.ts",
    "src/chat/thread-state.ts",
    "src/chat/tool-display.ts",
    "tests/**/*.ts"
  ]
}
