# Copy to app/backend/doric-host/.env and fill in the empty values (see the root README).

DORIC_POSTGRES_USER=doric
DORIC_POSTGRES_DB=doric
# Generate with: openssl rand -hex 24
DORIC_POSTGRES_PASSWORD=
# Generate once with: openssl rand -base64 32. Keep this key across restarts.
DORIC_CREDENTIAL_KEY=

# Share the host's Docker socket with every Project sandbox, so `docker build`
# works inside it and the sandbox image's Docker CLI has a daemon to reach.
# A sandbox holding the socket has the Docker daemon's authority on the host:
# keep it on for local development, and off where Projects are not yours.
DORIC_SANDBOX_DOCKER_SOCKET=true
