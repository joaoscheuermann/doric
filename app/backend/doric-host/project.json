{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "doric-host",
  "projectType": "application",
  "sourceRoot": "app/backend/doric-host/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["^build", "build-bundles"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "outputPath": "app/backend/doric-host/dist",
        "main": "app/backend/doric-host/src/index.ts",
        "tsConfig": "app/backend/doric-host/tsconfig.lib.json",
        "clean": false
      }
    },
    "build-bundles": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist/bundles"],
      "options": {
        "commands": [
          "node packages/bundle/dist/build/cli.js stage app/backend/doric-host/dist/bundles --all bundles"
        ],
        "parallel": false
      },
      "dependsOn": [
        {
          "target": "build",
          "projects": ["tag:type:bundle"]
        }
      ],
      "cache": false
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate deploy --config app/backend/doric-host/prisma.config.ts"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node app/backend/doric-host/dist/src/index.js"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "continuous": true,
      "options": {
        "command": "node app/backend/doric-host/dist/src/index.js"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "build"],
      "cache": false,
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "tsc -p app/backend/doric-host/tsconfig.spec.json",
          "node --test app/backend/doric-host/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": []
}
