{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "bundle-core",
  "projectType": "library",
  "sourceRoot": "bundles/foundation/core/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "tsc --build bundles/foundation/core/tsconfig.json",
          "node packages/bundle/dist/build/cli.js build bundles/foundation/core"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "commands": [
          "tsc --build bundles/foundation/core/tsconfig.json --emitDeclarationOnly",
          "tsc -p bundles/foundation/core/tsconfig.parts.json",
          "tsc -p bundles/foundation/core/tsconfig.client.json"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        "^build",
        {
          "projects": [
            "bundle-postgres",
            "bundle-files",
            "bundle-web",
            "bundle-git",
            "bundle-threads",
            "bundle-terminal",
            "bundle-usage",
            "bundle-resources",
            "bundle-runtime",
            "bundle-default",
            "bundle-openai",
            "bundle-openrouter",
            "bundle-codex",
            "bundle-docker",
            "bundle-notifications",
            "bundle-layout",
            "bundle-settings",
            "bundle-chat",
            "bundle-history",
            "bundle-host-config",
            "bundle-transport"
          ],
          "target": "build"
        }
      ],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "tsc -p bundles/foundation/core/tsconfig.spec.json",
          "tsc -p bundles/foundation/core/tsconfig.client-spec.json",
          "node --test bundles/foundation/core/dist-tests/tests/*.test.js bundles/foundation/core/dist-tests/tests/desktop/*.test.js bundles/foundation/core/dist-tests/tests/client/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["type:bundle"]
}
