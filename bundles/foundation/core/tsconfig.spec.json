{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "outDir": "dist-tests",
    "rootDir": ".",
    "tsBuildInfoFile": "dist-tests/tsconfig.spec.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "references": [
    {
      "path": "../../../packages/bundle/tsconfig.lib.json"
    },
    {
      "path": "../../../packages/storage/tsconfig.lib.json"
    },
    {
      "path": "../../../packages/tool/tsconfig.lib.json"
    },
    {
      "path": "../../../packages/llms/tsconfig.lib.json"
    },
    {
      "path": "../../providers/codex"
    },
    {
      "path": "../../providers/openai"
    },
    {
      "path": "../../providers/openrouter"
    }
  ],
  "exclude": ["src/desktop/**", "src/client/**", "tests/client/**"]
}
