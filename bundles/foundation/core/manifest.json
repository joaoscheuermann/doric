    "models/v1@1.1.0",
    "core.settings/v1@1.0.0",
    "core.settings-generation/v1@1.0.0",
    "commands/v1@1.0.0",
    "windows/v1@1.1.0",
    "menus/v1@1.0.0",
    "core.hooks/v1@1.0.0",
    "core.event-hooks/v1@1.0.0",
    "core.open-settings/v1@1.0.0",
