{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "bundle-host-config",
  "projectType": "library",
  "sourceRoot": "bundles/foundation/host-config/src",
  "targets": {
    "generate-proto": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/buf.yaml",
        "{workspaceRoot}/buf.lock",
        "{workspaceRoot}/buf.gen.yaml",
        "{projectRoot}/proto/**/*.proto",
        {
          "externalDependencies": ["@bufbuild/buf", "@bufbuild/protoc-gen-es"]
        }
      ],
      "outputs": ["{projectRoot}/src/contracts/gen"],
      "options": {
        "commands": [
          "npx buf generate --template buf.gen.yaml --path bundles/foundation/host-config/proto/doric -o bundles/foundation/host-config"
        ],
        "parallel": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-proto", "^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "tsc --build bundles/foundation/host-config/tsconfig.json",
          "node packages/bundle/dist/build/cli.js build bundles/foundation/host-config"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-proto", "^build"],
      "options": {
        "command": "tsc --build bundles/foundation/host-config/tsconfig.json --emitDeclarationOnly"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "^build"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "tsc -p bundles/foundation/host-config/tsconfig.spec.json",
          "node --test bundles/foundation/host-config/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["type:bundle"]
}
