{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "bundle-runtime",
  "projectType": "library",
  "sourceRoot": "bundles/runtime/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "tsc --build bundles/runtime/tsconfig.json",
          "node packages/bundle/dist/build/cli.js build bundles/runtime"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc --build bundles/runtime/tsconfig.json --emitDeclarationOnly"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "^build"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "tsc -p bundles/runtime/tsconfig.spec.json",
          "node --test 'bundles/runtime/dist-tests/tests/**/*.test.js'"
        ],
        "parallel": false
      }
    },
    "contracts-baseline": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "node packages/bundle/dist/build/cli.js baseline bundles/runtime",
          "biome format --write bundles/runtime/contracts.published.json"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["type:bundle"]
}
