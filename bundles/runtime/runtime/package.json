{
  "name": "runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./contracts": {
      "@org/source": "./src/contracts/index.ts",
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "default": "./dist/contracts/index.js"
    },
    "./contracts/gen/*": {
      "@org/source": "./src/contracts/gen/*",
      "types": "./dist/contracts/gen/*",
      "import": "./dist/contracts/gen/*",
      "default": "./dist/contracts/gen/*"
    },
    "./testing": {
      "@org/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "bundle": "0.0.1",
    "core": "0.0.1",
    "host-config": "0.0.1",
    "sandbox": "0.0.1",
    "sandpool": "0.0.1",
    "storage": "0.0.1",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@types/pg": "8.15.5",
    "desktop": "1.0.0",
    "pg": "8.16.3",
    "postgres": "0.0.1",
    "zustand": "^5.0.15"
  }
}
