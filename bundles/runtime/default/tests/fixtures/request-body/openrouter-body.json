{
  "fields": {
    "model": "deepseek/fake-chat",
    "provider": {
      "require_parameters": true
    },
    "reasoning": {
      "effort": "low"
    },
    "stream": true,
    "stream_options": {
      "include_usage": true
    }
  },
  "nonSystemMessages": [
    {
      "content": "<user-request>\n[[plain]] Say hello.\n</user-request>",
      "role": "user"
    }
  ],
  "path": "/chat/completions",
  "tools": [
    {
      "function": {
        "description": "Report this thread's working directory, or move it to a given path. A relative path resolves against the current directory, the way cd does. A move takes effect only when the path is a directory inside the workspace root, and every other tool resolves its relative paths against this directory. Move here as soon as the work moves into a repository or a subdirectory - after a clone, for instance - so the other tools run in it.",
        "name": "cwd",
        "parameters": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
        "description": "Edit a file using exact text replacement. Each edit's oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit. A relative path resolves against the current working directory.",
        "name": "edit",
        "parameters": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "edits": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "newText": {
                    "type": "string"
                  },
                  "oldText": {
                    "type": "string"
                  }
                },
                "required": [
                  "oldText",
                  "newText"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "edits"
          ],
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
        "description": "Search for files by glob pattern. Returns matching file paths relative to the search directory. A relative path resolves against the current working directory. Respects .gitignore. Output is truncated to 1000 results or 50KB (whichever is hit first).",
        "name": "find",
        "parameters": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "limit": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "path": {
              "type": "string"
            },
            "pattern": {
              "type": "string"
            }
          },
          "required": [
            "pattern"
          ],
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
        "description": "Search file contents for a pattern. Returns matching lines with file paths and line numbers. A relative path resolves against the current working directory. Respects .gitignore. Output is truncated to 100 matches or 50KB (whichever is hit first). Long lines are truncated to 500 chars.",
        "name": "grep",
        "parameters": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "context": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "glob": {
              "type": "string"
            },
            "ignoreCase": {
              "type": "boolean"
            },
            "limit": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "literal": {
              "type": "boolean"
            },
            "path": {
              "type": "string"
            },
            "pattern": {
              "type": "string"
            }
          },
          "required": [
            "pattern"
          ],
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
        "description": "Executes tracked shell commands in the current working directory. Foreground returns compact output and exit status. Set background to continue working immediately; the host delivers the terminal result to this Thread when it ends. Set pty for interactive commands (stdout and stderr are combined). A relative working_directory resolves against the current directory.",
        "name": "terminal",
        "parameters": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "background": {
              "type": "boolean"
            },
            "command": {
              "type": "string"
            },
            "pty": {
              "type": "boolean"
            },
            "timeout_ms": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "working_directory": {
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
        "description": "Display directory structure as an ASCII tree. Directories are listed first, then files, both sorted alphabetically. Respects .gitignore and excludes hidden files except .agents. A relative path resolves against the current working directory.",
        "name": "tree",
        "parameters": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "exclude": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "path": {
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
        "description": "Search the web, open HTTP(S) pages as extracted text, or find literal text in a page.",
        "name": "web",
        "parameters": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "action": {
              "enum": [
                "search",
                "open_page",
                "find_in_page"
              ],
              "type": "string"
            },
            "ignoreCase": {
              "type": "boolean"
            },
            "limit": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "maxChars": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "pattern": {
              "type": "string"
            },
            "query": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
        "description": "Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories. A relative path resolves against the current working directory.",
        "name": "write",
        "parameters": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "content": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "content"
          ],
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
        "description": "Runs one non-interactive Git command in the sandbox from structured arguments, without shell interpretation. Supports repository inspection and mutation, including clone, worktree, commit, fetch, push, rebase, and conflict workflows. Runs in the current working directory, and a relative working_directory resolves against it. After a clone, move the thread's working directory into the repository with the cwd tool.",
        "name": "git",
        "parameters": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "args": {
              "items": {
                "maxLength": 8192,
                "type": "string"
              },
              "maxItems": 128,
              "minItems": 1,
              "type": "array"
            },
            "timeout_ms": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "working_directory": {
              "type": "string"
            }
          },
          "required": [
            "args"
          ],
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
        "description": "Create an agent thread and delegate a self-contained task. Returns immediately. The child shares this project workspace; its result arrives automatically in this chat. The reader can watch it, pause it, continue it and retry it, but never prompt or delete it, so the task must stand on its own. Give it a short title (up to 80 characters) naming the task, as the user sees it in the thread list; without one, the thread is named after the start of the prompt. Set agent to run the child as one of the agents listed under # Agents, with that agent's instructions; without it, the child is a plain thread. model and effort override the agent's defaults; without them the child uses the agent's, else yours.",
        "name": "thread-spawn",
        "parameters": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "agent": {
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            "effort": {
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ],
              "type": "string"
            },
            "model": {
              "minLength": 1,
              "type": "string"
            },
            "prompt": {
              "minLength": 1,
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "prompt"
          ],
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
        "description": "List your direct child chats and their states. Use the next cursor to continue.",
        "name": "thread-list",
        "parameters": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "cursor": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            },
            "limit": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
        "description": "Read a direct child chat's state and, when a prompt has finished, the result of its most recent finished prompt. It never carries the transcript; use thread-events only when intermediate progress is needed.",
        "name": "thread-get",
        "parameters": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "threadId": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          },
          "required": [
            "threadId"
          ],
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
        "description": "Read a bounded page of a direct child chat's persisted events after an exclusive sequence cursor, as a compact digest. The returned nextSequence continues the read. Prefer thread-get: the child's result already arrives automatically, so reach for this only to inspect intermediate progress.",
        "name": "thread-events",
        "parameters": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "afterSequence": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "limit": {
              "maximum": 50,
              "minimum": 1,
              "type": "integer"
            },
            "threadId": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          },
          "required": [
            "threadId"
          ],
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
        "description": "Queue a follow-up task or instruction in a direct child chat without interrupting its current execution. Its result returns automatically. A child whose prompt failed is already healthy — this continues it; a child whose thread itself failed needs thread-restart.",
        "name": "thread-send",
        "parameters": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "prompt": {
              "minLength": 1,
              "type": "string"
            },
            "threadId": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          },
          "required": [
            "threadId",
            "prompt"
          ],
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
        "description": "Cancel only the identified active prompt of a direct child. Keeps its queued inputs, descendants and chat open. Does not undo effects.",
        "name": "thread-interrupt",
        "parameters": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "promptId": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            },
            "threadId": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          },
          "required": [
            "threadId",
            "promptId"
          ],
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
        "description": "Close a direct child and its descendants, cancelling active and queued work. Keeps history and the shared project sandbox.",
        "name": "thread-terminate",
        "parameters": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "threadId": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          },
          "required": [
            "threadId"
          ],
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
        "description": "Reopen a direct child chat whose thread itself failed and queue a prompt in it: the one you give, or the last prompt the child accepted. Same chat, same history, same parent. A child whose prompt failed but whose thread is healthy is already continuable — use thread-send for that. A cancelled child cannot be reopened, and only a live parent can restart its child.",
        "name": "thread-restart",
        "parameters": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "prompt": {
              "minLength": 1,
              "type": "string"
            },
            "threadId": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          },
          "required": [
            "threadId"
          ],
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "type": "function",
      "function": {
        "name": "load_skill",
        "description": "Loads a skill listed under \"Skills to load\" in your instructions or in a later \"Skills changed\" message, and returns its instructions. Call it before starting work that a listed skill's description matches.",
        "parameters": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "The skill's id, as listed in the Skill column."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}