{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "bundle-default",
  "projectType": "library",
  "sourceRoot": "bundles/runtime/default/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "tsc --build bundles/runtime/default/tsconfig.json",
          "node packages/bundle/dist/build/cli.js build bundles/runtime/default"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc --build bundles/runtime/default/tsconfig.json --emitDeclarationOnly"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "tsc -p bundles/runtime/default/tsconfig.spec.json",
          "node packages/bundle/dist/build/cli.js copy-md bundles/runtime/default/src/host bundles/runtime/default/dist-tests/src/host",
          "node --test bundles/runtime/default/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["type:bundle"]
}
