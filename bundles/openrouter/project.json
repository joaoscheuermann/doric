{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "bundle-openrouter",
  "projectType": "library",
  "sourceRoot": "bundles/openrouter/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "tsc --build bundles/openrouter/tsconfig.json",
          "node packages/bundle/dist/build/cli.js build bundles/openrouter"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc --build bundles/openrouter/tsconfig.json --emitDeclarationOnly"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "tsc -p bundles/openrouter/tsconfig.spec.json",
          "node --test bundles/openrouter/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["type:bundle"]
}
