{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "bundle-terminal",
  "projectType": "library",
  "sourceRoot": "bundles/terminal/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "tsc --build bundles/terminal/tsconfig.json",
          "tsc -p bundles/terminal/tsconfig.client.json",
          "node packages/bundle/dist/build/cli.js build bundles/terminal"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "commands": [
          "tsc --build bundles/terminal/tsconfig.json --emitDeclarationOnly",
          "tsc -p bundles/terminal/tsconfig.client.json"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "rm -rf bundles/terminal/dist-tests",
          "tsc -p bundles/terminal/tsconfig.spec.json",
          "node --test bundles/terminal/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    },
    "contracts-baseline": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "node packages/bundle/dist/build/cli.js baseline bundles/terminal",
          "biome format --write bundles/terminal/contracts.published.json"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["type:bundle"]
}
