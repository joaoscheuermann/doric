{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "outDir": "dist-tests",
    "rootDir": ".",
    "tsBuildInfoFile": "dist-tests/tsconfig.spec.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "src/host/**/*.ts",
    "src/contracts/**/*.ts",
    "src/client/domain/**/*.ts",
    "tests/*.ts",
    "tests/support/**/*.ts"
  ],
  "references": [
    {
      "path": "../../../packages/bundle/tsconfig.lib.json"
    },
    {
      "path": "../../../packages/tool/tsconfig.lib.json"
    },
    {
      "path": "../../runtime/runtime"
    }
  ],
  "exclude": []
}
