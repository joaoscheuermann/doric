{
  "manifestVersion": 1,
  "id": "openui",
  "version": "2.3.4",
  "engines": { "doric": "^1.0.0" },
  "description": "Answers with UI in the conversation: OpenUI Lang fences drawn while the agent writes, diagrams laid out by the app, the question form, actions back to the agent and validation feedback.",
  "provides": [
    "openui.programs/v1@1.1.0",
    "openui.questions/v1@1.1.0",
    "openui.answered/v1@1.1.0"
  ],
  "requires": [
    "chat.views/v1@^1.1.0",
    "chat.send/v1@^1.1.0",
    "runtime.threads/v1@^1.8.0",
    "runtime.hooks/v1@^1.2.0",
    "hooks/v1@^1.1.0",
    "events/v1@^1.1.0",
    "skills/v1@^1.2.0",
    "ui/v1@^1.0.0"
  ],
  "optional": ["chat.hooks/v2", "log/v1", "secrets/v1"],
  "host": { "assets": ["src/host/skills/*.md"] },
  "desktopScope": {
    "openui.programs/v1": ["projectId", "threadId"],
    "openui.questions/v1": ["projectId", "threadId"]
  }
}
