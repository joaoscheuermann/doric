{
  "name": "screen-relay",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./contracts": {
      "@org/source": "./src/contracts/index.ts",
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "default": "./dist/contracts/index.js"
    },
    "./contracts/gen/*": {
      "@org/source": "./src/contracts/gen/*",
      "types": "./dist/contracts/gen/*",
      "import": "./dist/contracts/gen/*",
      "default": "./dist/contracts/gen/*"
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "bundle": "0.0.1",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  }
}
