{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "bundle-screen-relay",
  "projectType": "library",
  "sourceRoot": "bundles/features/screen-relay/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "tsc --build bundles/features/screen-relay/tsconfig.json",
          "node packages/bundle/dist/build/cli.js build bundles/features/screen-relay"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc --build bundles/features/screen-relay/tsconfig.json --emitDeclarationOnly"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "rm -rf bundles/features/screen-relay/dist-tests",
          "tsc -p bundles/features/screen-relay/tsconfig.spec.json",
          "node --test bundles/features/screen-relay/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["type:bundle"]
}
