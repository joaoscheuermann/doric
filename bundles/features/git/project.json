{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "bundle-git",
  "projectType": "library",
  "sourceRoot": "bundles/features/git/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "tsc --build bundles/features/git/tsconfig.json",
          "tsc -p bundles/features/git/tsconfig.client.json",
          "node packages/bundle/dist/build/cli.js build bundles/features/git"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "commands": [
          "tsc --build bundles/features/git/tsconfig.json --emitDeclarationOnly",
          "tsc -p bundles/features/git/tsconfig.client.json"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "tsc -p bundles/features/git/tsconfig.spec.json",
          "node --test bundles/features/git/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["type:bundle"]
}
