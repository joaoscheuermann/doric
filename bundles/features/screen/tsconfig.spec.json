{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "outDir": "dist-tests",
    "rootDir": ".",
    "tsBuildInfoFile": "dist-tests/tsconfig.spec.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "src/host/**/*.ts",
    "src/contracts/**/*.ts",
    "src/desktop/**/*.ts",
    "src/client/api.ts",
    "src/client/dial.ts",
    "src/client/peers.ts",
    "src/client/store.ts",
    "tests/**/*.ts"
  ],
  "exclude": [],
  "references": [
    { "path": "../../../packages/bundle/tsconfig.lib.json" },
    { "path": "../../../packages/sandbox/tsconfig.lib.json" },
    { "path": "../../runtime/runtime" }
  ]
}
