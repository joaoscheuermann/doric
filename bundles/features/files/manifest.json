{
  "manifestVersion": 1,
  "id": "files",
  "version": "1.10.0",
  "engines": { "doric": "^1.10.0" },
  "description": "Core capabilities available to the Doric agent.",
  "provides": [
    "files/v1@1.4.0",
    "files.sandbox/v1@1.0.0",
    "files.refresh/v1@1.0.0",
    "files.open-file/v1@1.0.0"
  ],
  "requires": [
    "tools/v1@^1.5.0",
    "skills/v1@^1.3.0",
    "runtime.workspace/v1@^1.2.0",
    "runtime.lease/v1@^1.4.0",
    "runtime.attachments/v1@^1.1.0",
    "ui/v1@^1.0.0",
    "regions/v1@^1.0.0",
    "commands/v1@^1.0.0",
    "hooks/v1@^1.0.0",
    "workspace.selection/v1@^1.0.0",
    "runtime.records/v1@^1.0.0",
    "layout.panel/v3@^3.0.0",
    "layout.tabs/v2@^2.0.0"
  ],
  "optional": [
    "files.decorations/v1",
    "chat.hooks/v2",
    "chat.views/v1",
    "log/v1",
    "secrets/v1"
  ],
  "desktopScope": {
    "files/v1": ["projectId", "threadId", "promptId"]
  },
  "host": { "assets": ["src/skills/*/SKILL.md"] }
}
