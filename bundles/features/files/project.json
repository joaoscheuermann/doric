{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "bundle-files",
  "projectType": "library",
  "sourceRoot": "bundles/features/files/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "tsc --build bundles/features/files/tsconfig.json",
          "tsc -p bundles/features/files/tsconfig.client.json",
          "node packages/bundle/dist/build/cli.js build bundles/features/files"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "commands": [
          "tsc --build bundles/features/files/tsconfig.json --emitDeclarationOnly",
          "tsc -p bundles/features/files/tsconfig.client.json"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "^build"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "rm -rf bundles/features/files/dist-tests",
          "tsc -p bundles/features/files/tsconfig.spec.json",
          "tsc -p bundles/features/files/tsconfig.client-spec.json",
          "node --test --test-force-exit bundles/features/files/dist-tests/tests/*.test.js bundles/features/files/dist-tests/tests/client/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["type:bundle"]
}
