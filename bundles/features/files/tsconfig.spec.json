{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "outDir": "dist-tests",
    "rootDir": ".",
    "tsBuildInfoFile": "dist-tests/tsconfig.spec.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "src/host/**/*.ts",
    "src/contracts/**/*.ts",
    "src/client/api/**/*.ts",
    "src/client/refresh/**/*.ts",
    "src/client/stores/**/*.ts",
    "src/client/commands.ts",
    "src/client/sandbox-store.ts",
    "src/client/state.ts",
    "tests/**/*.ts"
  ],
  "references": [
    {
      "path": "../../../packages/bundle/tsconfig.lib.json"
    },
    {
      "path": "../../../packages/tool/tsconfig.lib.json"
    },
    {
      "path": "../../../packages/sandbox/tsconfig.lib.json"
    },
    {
      "path": "../../../packages/sandpool/tsconfig.lib.json"
    },
    {
      "path": "../../runtime/runtime"
    },
    {
      "path": "../terminal"
    },
    {
      "path": "../../../packages/desktop/tsconfig.lib.json"
    },
    {
      "path": "../../desktop/layout"
    }
  ]
}
