{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "emitDeclarationOnly": false,
    "declaration": true,
    "declarationMap": true,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../../packages/sandbox"
    },
    {
      "path": "../../runtime/runtime"
    },
    {
      "path": "../../../packages/bundle"
    },
    {
      "path": "../../../packages/desktop"
    }
  ],
  "exclude": ["src/client/**"]
}
