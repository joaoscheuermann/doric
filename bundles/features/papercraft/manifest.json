{
  "manifestVersion": 1,
  "id": "papercraft",
  "version": "1.2.0",
  "engines": { "doric": "^1.0.0" },
  "description": "Live previews of a Project's code as conversation nodes: the `preview` artifact kind, its builder and its canvas window.",
  "provides": [
    "papercraft.previews/v1@1.0.0",
    "papercraft.open-canvas/v1@1.0.0",
    "papercraft.approve/v1@1.0.0",
    "papercraft.select/v1@1.0.0",
    "papercraft.comment/v1@1.0.0",
    "papercraft.pan/v1@1.0.0",
    "papercraft.isolate/v1@1.0.0",
    "papercraft.show-all/v1@1.0.0",
    "papercraft.zoom-out/v1@1.0.0",
    "papercraft.zoom-reset/v1@1.0.0",
    "papercraft.zoom-in/v1@1.0.0",
    "papercraft.zoom-fit/v1@1.0.0",
    "papercraft.select-revision/v1@1.0.0",
    "papercraft.send/v1@1.0.0",
    "papercraft.snapshot/v1@1.0.0"
  ],
  "requires": [
    "files/v1@^1.1.0",
    "runtime.lease/v1@^1.1.0",
    "artifacts/v1@^1.0.0",
    "artifacts.cache/v1@^1.0.0",
    "artifact.kind/v1@^1.0.0",
    "comments/v1@^1.0.0",
    "tools/v1@^1.0.0",
    "ui/v1@^1.0.0",
    "navigation/v1@^1.0.0",
    "commands/v1@^1.0.0",
    "menus/v1@^1.0.0",
    "hooks/v1@^1.0.0",
    "windows/v1@^1.0.0"
  ],
  "optional": ["chat.composer/v1", "chat.send/v1", "runtime.threads/v1"],
  "desktopScope": {
    "papercraft.previews/v1": ["projectId", "threadId", "promptId"]
  }
}
