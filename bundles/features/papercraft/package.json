{
  "name": "papercraft",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./contracts": {
      "@org/source": "./src/contracts/index.ts",
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "default": "./dist/contracts/index.js"
    },
    "./contracts/gen/*": {
      "@org/source": "./src/contracts/gen/*",
      "types": "./dist/contracts/gen/*",
      "import": "./dist/contracts/gen/*",
      "default": "./dist/contracts/gen/*"
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@openuidev/lang-core": "1.0.2",
    "@openuidev/react-lang": "1.0.2",
    "@openuidev/react-ui": "0.18.1",
    "@tailwindcss/oxide": "4.3.3",
    "bundle": "0.0.1",
    "comments": "0.0.1",
    "desktop": "1.0.0",
    "esbuild": "0.28.2",
    "files": "0.0.1",
    "jdenticon": "^3.3.0",
    "lucide-react": "^0.544.0",
    "openui": "0.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "runtime": "0.0.1",
    "tailwindcss": "4.3.3",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bufbuild/protovalidate": "^1.3.0",
    "happy-dom": "20.8.9"
  }
}
