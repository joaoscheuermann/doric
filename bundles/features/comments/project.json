{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "bundle-comments",
  "projectType": "library",
  "sourceRoot": "bundles/features/comments/src",
  "targets": {
    "generate-proto": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/buf.yaml",
        "{workspaceRoot}/buf.lock",
        "{workspaceRoot}/buf.gen.yaml",
        "{projectRoot}/proto/**/*.proto",
        {
          "externalDependencies": ["@bufbuild/buf", "@bufbuild/protoc-gen-es"]
        }
      ],
      "outputs": ["{projectRoot}/src/contracts/gen"],
      "options": {
        "commands": [
          "npx buf generate --template buf.gen.yaml --path bundles/features/comments/proto/doric -o bundles/features/comments"
        ],
        "parallel": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-proto", "^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "tsc --build bundles/features/comments/tsconfig.json",
          "node packages/bundle/dist/build/cli.js build bundles/features/comments"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-proto", "^build"],
      "options": {
        "commands": [
          "tsc --build bundles/features/comments/tsconfig.json --emitDeclarationOnly"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "^build"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "rm -rf bundles/features/comments/dist-tests",
          "tsc -p bundles/features/comments/tsconfig.spec.json",
          "node --test bundles/features/comments/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["type:bundle"]
}
