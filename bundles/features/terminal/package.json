{
  "name": "terminal",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./host": {
      "@org/source": "./src/host/index.ts",
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js",
      "default": "./dist/host/index.js"
    },
    "./contracts": {
      "@org/source": "./src/contracts/index.ts",
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "default": "./dist/contracts/index.js"
    },
    "./contracts/gen/*": {
      "@org/source": "./src/contracts/gen/*",
      "types": "./dist/contracts/gen/*",
      "import": "./dist/contracts/gen/*",
      "default": "./dist/contracts/gen/*"
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "bundle": "0.0.1",
    "runtime": "0.0.1",
    "sandbox": "0.0.1",
    "tool": "0.0.1",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bufbuild/protovalidate": "^1.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chat": "0.0.1",
    "desktop": "1.0.0",
    "docker-sandbox": "0.0.1",
    "happy-dom": "20.8.9",
    "layout": "0.0.1",
    "lucide-react": "^0.544.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "workspace": "0.0.1"
  }
}
