{
  "manifestVersion": 1,
  "id": "terminal",
  "version": "1.2.1",
  "engines": { "doric": "^1.10.0" },
  "description": "Tracked shell commands and manual terminal sessions.",
  "provides": ["terminal/v1@1.3.0"],
  "requires": [
    "tools/v1@^1.5.0",
    "secrets/v1@^1.3.0",
    "hooks/v1@^1.1.0",
    "log/v1@^1.0.0",
    "runtime.workspace/v1@^1.3.0",
    "runtime.threads/v1@^1.2.0",
    "runtime.hooks/v1@^1.1.0",
    "ui/v1@^1.0.0",
    "regions/v1@^1.0.0",
    "navigation/v1@^1.0.0",
    "workspace.selection/v1@^1.0.0",
    "runtime.records/v1@^1.0.0",
    "layout.tabs/v2@^2.0.0",
    "workspace.sidebar/v1@^1.0.0",
    "runtime.lease/v1@^1.5.0"
  ],
  "optional": ["files.refresh/v1", "chat.views/v1"],
  "desktopScope": {
    "terminal/v1": ["projectId", "threadId", "promptId"]
  }
}
