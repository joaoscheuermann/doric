{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "bundle-workspace",
  "projectType": "library",
  "sourceRoot": "bundles/desktop/workspace/src",
  "targets": {
    "generate-proto": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/buf.yaml",
        "{workspaceRoot}/buf.lock",
        "{workspaceRoot}/buf.gen.yaml",
        "{projectRoot}/proto/**/*.proto",
        {
          "externalDependencies": ["@bufbuild/buf", "@bufbuild/protoc-gen-es"]
        }
      ],
      "outputs": ["{projectRoot}/src/contracts/gen"],
      "options": {
        "commands": [
          "npx buf generate --template buf.gen.yaml --path bundles/desktop/workspace/proto/doric -o bundles/desktop/workspace"
        ],
        "parallel": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-proto", "^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "tsc --build bundles/desktop/workspace/tsconfig.json",
          "tsc -p bundles/desktop/workspace/tsconfig.client.json",
          "node packages/bundle/dist/build/cli.js build bundles/desktop/workspace"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-proto", "^build"],
      "options": {
        "commands": [
          "tsc --build bundles/desktop/workspace/tsconfig.json --emitDeclarationOnly",
          "tsc -p bundles/desktop/workspace/tsconfig.client.json"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "^build"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "rm -rf bundles/desktop/workspace/dist-tests",
          "tsc -p bundles/desktop/workspace/tsconfig.spec.json",
          "tsc -p bundles/desktop/workspace/tsconfig.client-spec.json",
          "node --test --test-force-exit bundles/desktop/workspace/dist-tests/tests/*.test.js bundles/desktop/workspace/dist-tests/tests/client/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["type:bundle"]
}
