{
  "manifestVersion": 1,
  "id": "chat",
  "version": "1.9.1",
  "engines": {
    "doric": "^1.9.0"
  },
  "description": "The conversation: transcript, composer and the execution picker.",
  "provides": [
    "chat.views/v1@1.1.0",
    "chat.lexical/v1@1.0.0",
    "chat.hooks/v1@1.1.0",
    "chat.composer/v1@1.0.0",
    "chat.send/v1@1.1.0",
    "chat.send-prompt/v1@1.0.0"
  ],
  "optional": [
    "history.snapshots/v1",
    "terminal/v1",
    "runtime.terminals/v1",
    "models/v1",
    "comments.added/v1",
    "comments.resolved/v1",
    "runtime.prompt-finished/v1",
    "workspace.hooks/v1",
    "settings.models/v1",
    "workspace.selection/v1"
  ],
  "requires": [
    "hooks/v1@^1.0.0",
    "ui/v1@^1.0.0",
    "navigation/v1@^1.0.0",
    "regions/v1@^1.0.0",
    "commands/v1@^1.0.0",
    "menus/v1@^1.0.0",
    "runtime.threads/v1@^1.8.0",
    "runtime.attachments/v1@^1.0.0",
    "runtime.records/v1@^1.0.0",
    "comments/v1@^1.0.0",
    "chat.composer/v1@^1.0.0",
    "layout.tabs/v2@^2.0.0"
  ],
  "desktopScope": {
    "chat.composer/v1": ["projectId", "threadId", "promptId"]
  }
}
