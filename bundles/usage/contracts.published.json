{
  "descriptorVersion": 1,
  "bundle": {
    "id": "usage",
    "version": "1.0.0"
  },
  "contracts": [
    {
      "id": "usage/v1",
      "version": "1.0.0",
      "kind": "service",
      "environment": "host",
      "cardinality": "one",
      "local": false,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "doric:contract/usage/v1",
        "x-doric-kind": "service",
        "$defs": {
          "thread.input": {
            "type": "string"
          },
          "thread.output": {
            "type": "object",
            "properties": {
              "context": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "providerId": {
                    "type": "string"
                  },
                  "contextWindowSource": {
                    "type": "string",
                    "const": "catalog"
                  },
                  "contextWindow": {
                    "type": "number"
                  },
                  "inputTokens": {
                    "type": "number"
                  }
                },
                "required": ["model"],
                "additionalProperties": {}
              },
              "total": {
                "type": "object",
                "properties": {
                  "calls": {
                    "type": "number"
                  },
                  "unpricedCalls": {
                    "type": "number"
                  },
                  "cost": {
                    "type": "number"
                  },
                  "inputTokens": {
                    "type": "number"
                  },
                  "outputTokens": {
                    "type": "number"
                  },
                  "cachedInputTokens": {
                    "type": "number"
                  },
                  "reasoningTokens": {
                    "type": "number"
                  }
                },
                "required": [
                  "calls",
                  "unpricedCalls",
                  "cost",
                  "inputTokens",
                  "outputTokens",
                  "cachedInputTokens",
                  "reasoningTokens"
                ],
                "additionalProperties": {}
              },
              "threads": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "calls": {
                      "type": "number"
                    },
                    "unpricedCalls": {
                      "type": "number"
                    },
                    "cost": {
                      "type": "number"
                    },
                    "inputTokens": {
                      "type": "number"
                    },
                    "outputTokens": {
                      "type": "number"
                    },
                    "cachedInputTokens": {
                      "type": "number"
                    },
                    "reasoningTokens": {
                      "type": "number"
                    },
                    "threadId": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "parentThreadId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "calls",
                    "unpricedCalls",
                    "cost",
                    "inputTokens",
                    "outputTokens",
                    "cachedInputTokens",
                    "reasoningTokens",
                    "threadId",
                    "name"
                  ],
                  "additionalProperties": {}
                }
              }
            },
            "required": ["total", "threads"],
            "additionalProperties": {}
          }
        }
      }
    }
