{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "bundle-threads",
  "projectType": "library",
  "sourceRoot": "bundles/threads/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "tsc --build bundles/threads/tsconfig.json",
          "tsc -p bundles/threads/tsconfig.client.json",
          "node packages/bundle/dist/build/cli.js build bundles/threads"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "commands": [
          "tsc --build bundles/threads/tsconfig.json --emitDeclarationOnly",
          "tsc -p bundles/threads/tsconfig.client.json"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "^build"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "rm -rf bundles/threads/dist-tests",
          "tsc -p bundles/threads/tsconfig.spec.json",
          "tsc -p bundles/threads/tsconfig.client-spec.json",
          "node --test --test-force-exit bundles/threads/dist-tests/tests/*.test.js bundles/threads/dist-tests/tests/client/*.test.js"
        ],
        "parallel": false
      }
    },
    "contracts-baseline": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "node packages/bundle/dist/build/cli.js baseline bundles/threads",
          "biome format --write bundles/threads/contracts.published.json"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["type:bundle"]
}
