generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * The closed set of credential kinds. The kind fixes the field set a row may
 * carry, which is why the invariant lives in the credentials domain rule rather
 * than in a row-level database constraint.
 */
enum CredentialKind {
  API_TOKEN
  USERNAME_PASSWORD
  GIT
}

enum ProjectState {
  QUEUED
  READY
  CANCELLING
  FAILED
  CANCELLED
}

enum ThreadState {
  QUEUED
  READY
  RUNNING
  CANCELLING
  FAILED
  CANCELLED
}

/**
 * One named credential. A provider key and the GitHub token are both
 * `API_TOKEN` rows whose secret is stored as a versioned ciphertext envelope.
 */
model Credential {
  id        String         @id @default(uuid()) @db.Uuid
  kind      CredentialKind
  name      String
  username  String?
  email     String?
  secret    String?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([kind, name])
  @@map("credential")
}

model Project {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  color          String?
  state          ProjectState @default(QUEUED)
  configRevision Int          @map("config_revision")
  configSnapshot Json         @map("config_snapshot") @db.JsonB
  errorCode      String?      @map("error_code")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  startedAt      DateTime?    @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?    @map("finished_at") @db.Timestamptz(3)
  threads        Thread[]

  @@index([createdAt, id])
  @@map("project")
}

model Thread {
  id             String        @id @default(uuid()) @db.Uuid
  projectId      String        @map("project_id") @db.Uuid
  parentThreadId String?       @map("parent_thread_id") @db.Uuid
  name           String
  state          ThreadState   @default(QUEUED)
  /// The Thread's own working directory, absolute inside its Project's sandbox.
  /// Every Thread starts at the sandbox workspace root.
  cwd            String        @default("/workspace")
  /// The cheap `is this a Git repository` hint of `cwd`: `git` when the
  /// directory's own root holds a `.git` marker, `github` when its `origin`
  /// points at github.com, and absent until a probe observes one.
  cwdRepo        String?       @map("cwd_repo")
  messages       Json          @default("[]") @db.JsonB
  checkpoints    Json          @default("{}") @db.JsonB
  /// Cumulative OpenRouter charges, independent of rewound conversation history.
  usage          Json?         @db.JsonB
  /// Reader-controlled dispatch gate; survives host restarts and history rewind.
  queuePaused    Boolean       @default(false) @map("queue_paused")
  activePromptId String?       @map("active_prompt_id") @db.Uuid
  errorCode      String?       @map("error_code")
  lastSequence   Int           @default(0) @map("last_sequence")
  /// The materialized result of the most recent finished prompt, so reading a
  /// child's state never has to reconstruct it from the event log.
  resultText     String?       @map("result_text")
  resultStatus   String?       @map("result_status")
  resultPromptId String?       @map("result_prompt_id") @db.Uuid
  resultAt       DateTime?     @map("result_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  startedAt      DateTime?     @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?     @map("finished_at") @db.Timestamptz(3)
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent         Thread?       @relation("ThreadTree", fields: [projectId, parentThreadId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction)
  children       Thread[]      @relation("ThreadTree")
  events         ThreadEvent[]

  @@unique([projectId, id])
  @@index([projectId, createdAt, id])
  @@index([projectId, parentThreadId, createdAt, id])
  @@map("thread")
}

model ThreadEvent {
  projectId String   @map("project_id") @db.Uuid
  threadId  String   @map("thread_id") @db.Uuid
  promptId  String   @map("prompt_id") @db.Uuid
  sequence  Int
  type      String
  event     Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  thread    Thread   @relation(fields: [projectId, threadId], references: [projectId, id], onDelete: Cascade)

  @@id([threadId, sequence])
  @@map("thread_event")
}

// Generic storage (`storage.backend/v1`). The backend reads and writes these
// tables with raw SQL; the models keep the schema and its migrations in step.
// The migration also owns what Prisma cannot express: `COLLATE "C"` on the
// key columns, the partial unique index of unique index entries and the
// positive revision CHECK.

/// Reserved metadata records, such as the host's storage identity.
model StorageMeta {
  key   String @id
  value Json   @db.JsonB

  @@map("storage_meta")
}

/// The index declarations of each document type, as the last `declareType` wrote them.
model StorageType {
  type       String   @id
  indexes    Json     @db.JsonB
  declaredAt DateTime @default(now()) @map("declared_at") @db.Timestamptz(3)

  @@map("storage_type")
}

model StorageDocument {
  type      String
  id        String
  revision  Int
  value     Json                @db.JsonB
  updatedAt DateTime            @default(now()) @map("updated_at") @db.Timestamptz(3)
  entries   StorageIndexEntry[]

  @@id([type, id])
  @@map("storage_document")
}

/// One key of one declared index of one document; `key` is the order-preserving encoding.
model StorageIndexEntry {
  type       String
  indexName  String          @map("index_name")
  key        Bytes
  documentId String          @map("document_id")
  uniqueKey  Boolean         @map("unique_key")
  document   StorageDocument @relation(fields: [type, documentId], references: [type, id], onDelete: Cascade)

  @@id([type, indexName, key, documentId])
  @@index([type, documentId])
  @@map("storage_index_entry")
}

/// A stream's counter: it never decreases, even after a truncation.
model StorageStream {
  stream       String               @id
  lastSequence Int                  @default(0) @map("last_sequence")
  entries      StorageStreamEntry[]
  truncations  StorageTruncation[]

  @@map("storage_stream")
}

model StorageStreamEntry {
  stream    String
  sequence  Int
  value     Json          @db.JsonB
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  owner     StorageStream @relation(fields: [stream], references: [stream], onDelete: Cascade)

  @@id([stream, sequence])
  @@map("storage_stream_entry")
}

/// One successful commit, in commit order: the feed.
model StorageCommit {
  position    BigInt              @id
  /// The `{ type, id }` keys the commit put or deleted.
  documents   Json                @db.JsonB
  /// The streams that received appends.
  streams     Json                @db.JsonB
  /// The streams the commit truncated.
  truncated   Json                @default("[]") @db.JsonB
  /// The streams the commit removed.
  dropped     Json                @default("[]") @db.JsonB
  committedAt DateTime            @default(now()) @map("committed_at") @db.Timestamptz(3)
  truncations StorageTruncation[]

  @@map("storage_commit")
}

/// A truncation mark: entries above `afterSequence` were removed when the stream was at `atSequence`.
model StorageTruncation {
  stream        String
  position      BigInt
  afterSequence Int           @map("after_sequence")
  atSequence    Int           @map("at_sequence")
  owner         StorageStream @relation(fields: [stream], references: [stream], onDelete: Cascade)
  commit        StorageCommit @relation(fields: [position], references: [position])

  @@id([stream, position])
  @@map("storage_truncation")
}

/// Content-addressed bytes; `hash` is `sha256:<hex>`.
model StorageBlob {
  hash      String   @id
  bytes     Bytes
  size      Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("storage_blob")
}
