                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["afterSequence", "atSequence"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["entries", "lastSequence", "truncations"],
            "additionalProperties": false
          }
