{
  "descriptorVersion": 1,
  "bundle": {
    "id": "models-adapter",
    "version": "0.0.0"
  },
  "contracts": [
    {
      "id": "models.provider/v1",
      "version": "1.0.0",
      "kind": "service",
      "environment": "host",
      "cardinality": "many",
      "local": true,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "doric:contract/models.provider/v1",
        "x-doric-kind": "service",
        "$defs": {
          "advertised.input": {
            "type": "array",
            "prefixItems": [],
            "minItems": 0,
            "maxItems": 0
          },
          "advertised.output": {
            "type": "boolean"
          },
          "catalog.input": {
            "type": "object",
            "properties": {
              "configuration": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "secret": {
                "type": "string"
              }
            },
            "required": ["configuration"],
            "additionalProperties": false
          },
          "catalog.output": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "read"
                  },
                  "models": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "reasonings": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "parameters": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "defaultEffort": {
                          "type": "string"
                        },
                        "mandatory": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "id",
                        "reasonings",
                        "parameters",
                        "mandatory"
                      ],
                      "additionalProperties": {}
                    }
                  }
                },
                "required": ["status", "models"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["absent", "failed"]
                  }
                },
                "required": ["status"],
                "additionalProperties": false
              }
            ]
          },
          "create.input": {
            "type": "object",
            "properties": {
              "providerId": {
                "type": "string"
              },
              "values": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "secret": {
                "x-doric-local": "callback"
              }
            },
            "required": ["providerId", "values"],
            "additionalProperties": false
          },
          "create.output": {
            "x-doric-local": "object"
          },
          "kind.input": {
            "type": "array",
            "prefixItems": [],
            "minItems": 0,
            "maxItems": 0
          },
          "kind.output": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": ["text", "url", "number", "enum", "secret"]
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "description": {
                      "type": "string"
                    },
                    "placeholder": {
                      "type": "string"
                    },
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "advanced": {
                      "type": "boolean"
                    }
                  },
                  "required": ["key", "label", "kind", "required"],
                  "additionalProperties": false
                }
              },
              "lists": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["models", "reasonings"]
                }
              }
            },
            "required": ["id", "label", "description", "fields", "lists"],
            "additionalProperties": false
          }
        }
      }
    }
  ]
