{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "bundle-models-adapter",
  "projectType": "library",
  "sourceRoot": "bundles/models-adapter/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "tsc --build bundles/models-adapter/tsconfig.json",
          "node packages/bundle/dist/build/cli.js build bundles/models-adapter"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc --build bundles/models-adapter/tsconfig.json --emitDeclarationOnly"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "tsc -p bundles/models-adapter/tsconfig.spec.json",
          "node --test bundles/models-adapter/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    },
    "contracts-baseline": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "node packages/bundle/dist/build/cli.js baseline bundles/models-adapter",
          "biome format --write bundles/models-adapter/contracts.published.json"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["type:bundle"]
}
