{
  "descriptorVersion": 1,
  "bundle": {
    "id": "chat",
    "version": "1.1.0"
  },
  "contracts": [
    {
      "id": "chat.hooks/v1",
      "version": "1.1.0",
      "kind": "hooks",
      "environment": "client",
      "cardinality": "one",
      "local": true,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "doric:contract/chat.hooks/v1",
        "x-doric-kind": "hooks",
        "$defs": {
          "onBeforeRenderBlockHook.input": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "promptId": {
                "type": "string"
              },
              "sequence": {
                "type": "number"
              },
              "data": {},
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": ["id", "label"],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "type",
              "promptId",
              "sequence",
              "data",
              "actions"
            ],
            "additionalProperties": false,
            "x-doric-hook-kind": "transform"
          },
          "onMountHook.input": {
            "type": "object",
            "properties": {
              "projectId": {
                "type": "string"
              },
              "threadId": {
                "type": "string"
              }
            },
            "required": ["projectId", "threadId"],
            "additionalProperties": false,
            "x-doric-hook-kind": "observe"
          },
          "onSandboxActivityHook.input": {
            "type": "object",
            "properties": {
              "projectId": {
                "type": "string"
              }
            },
            "required": ["projectId"],
            "additionalProperties": false,
            "x-doric-hook-kind": "observe"
          },
          "onThreadUpdateHook.input": {
            "x-doric-local": true,
            "x-doric-hook-kind": "observe"
          },
          "onUnmountHook.input": {
            "type": "object",
            "properties": {
              "projectId": {
                "type": "string"
              },
              "threadId": {
                "type": "string"
              }
            },
            "required": ["projectId", "threadId"],
            "additionalProperties": false,
            "x-doric-hook-kind": "observe"
          }
        }
      }
    },
    {
      "id": "chat.views/v1",
      "version": "1.0.0",
      "kind": "service",
      "environment": "client",
      "cardinality": "one",
      "local": true,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "doric:contract/chat.views/v1",
        "x-doric-kind": "service",
        "$defs": {
          "registerProjector.input": {
            "x-doric-local": true
          },
          "registerProjector.output": {
            "x-doric-local": true
          },
          "registerRenderer.input": {
            "type": "object",
            "properties": {
              "blockType": {
                "type": "string",
                "minLength": 1
              },
              "elementTag": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["blockType", "elementTag"],
            "additionalProperties": false
          },
          "registerRenderer.output": {
            "x-doric-local": true
          }
        }
      }
    },
    {
      "id": "chat.lexical/v1",
      "version": "1.0.0",
      "kind": "service",
      "environment": "client",
      "cardinality": "one",
      "local": true,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "doric:contract/chat.lexical/v1",
        "x-doric-kind": "service",
        "$defs": {
          "registerExtension.input": {
            "x-doric-local": true
          },
          "registerExtension.output": {
            "x-doric-local": true
          },
          "registerNodes.input": {
            "x-doric-local": true
          },
          "registerNodes.output": {
            "x-doric-local": true
          }
        }
      }
    }
  ]
}
