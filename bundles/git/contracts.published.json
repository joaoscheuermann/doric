{
  "descriptorVersion": 1,
  "bundle": {
    "id": "git",
    "version": "1.1.0"
  },
  "contracts": [
    {
      "id": "git.commands/v1",
      "version": "1.0.0",
      "kind": "service",
      "environment": "host",
      "cardinality": "one",
      "local": false,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "doric:contract/git.commands/v1",
        "x-doric-kind": "service",
        "$defs": {
          "branches.input": {
            "type": "string"
          },
          "branches.output": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "ready"
                  },
                  "value": {
                    "type": "object",
                    "properties": {
                      "branches": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "current": {
                              "type": "boolean"
                            },
                            "commit": {
                              "type": "string"
                            },
                            "subject": {
                              "type": "string"
                            },
                            "worktree": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "name",
                            "current",
                            "commit",
                            "subject",
                            "worktree"
                          ],
                          "additionalProperties": {}
                        }
                      },
                      "blocked": {
                        "type": "string"
                      }
                    },
                    "required": ["branches"],
                    "additionalProperties": {}
                  }
                },
                "required": ["status", "value"],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["missing", "inactive", "pending"]
                  }
                },
                "required": ["status"],
                "additionalProperties": {}
              }
            ]
          },
          "changes.input": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "changes.output": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "ready"
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "const": "read"
                          },
                          "path": {
                            "type": "string"
                          },
                          "repositories": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "path": {
                                  "type": "string"
                                },
                                "changes": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "path": {
                                        "type": "string"
                                      },
                                      "originalPath": {
                                        "type": "string"
                                      },
                                      "status": {
                                        "type": "string",
                                        "enum": [
                                          "added",
                                          "modified",
                                          "deleted",
                                          "renamed",
                                          "untracked",
                                          "conflicted"
                                        ]
                                      },
                                      "staged": {
                                        "type": "boolean"
                                      },
                                      "unstaged": {
                                        "type": "boolean"
                                      },
                                      "indexStatus": {
                                        "type": "string"
                                      },
                                      "worktreeStatus": {
                                        "type": "string"
                                      }
                                    },
                                    "required": [
                                      "path",
                                      "status",
                                      "staged",
                                      "unstaged",
                                      "indexStatus",
                                      "worktreeStatus"
                                    ],
                                    "additionalProperties": {}
                                  }
                                },
                                "added": {
                                  "type": "number"
                                },
                                "removed": {
                                  "type": "number"
                                }
                              },
                              "required": [
                                "path",
                                "changes",
                                "added",
                                "removed"
                              ],
                              "additionalProperties": {}
                            }
                          }
                        },
                        "required": ["status", "repositories"],
                        "additionalProperties": {}
                      },
                      {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": ["not_found", "invalid_path"]
                          }
                        },
                        "required": ["status"],
                        "additionalProperties": {}
                      }
                    ]
                  }
                },
                "required": ["status", "value"],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["pending", "unavailable", "expired", "missing"]
                  }
                },
                "required": ["status"],
                "additionalProperties": {}
              }
            ]
          },
          "diff.input": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "diff.output": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "ready"
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "const": "read"
                          },
                          "path": {
                            "type": "string"
                          },
                          "repositories": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "path": {
                                  "type": "string"
                                },
                                "diff": {
                                  "type": "string"
                                },
                                "changes": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "path": {
                                        "type": "string"
                                      },
                                      "status": {
                                        "type": "string",
                                        "enum": [
                                          "added",
                                          "modified",
                                          "deleted",
                                          "renamed",
                                          "untracked"
                                        ]
                                      }
                                    },
                                    "required": ["path", "status"],
                                    "additionalProperties": {}
                                  }
                                }
                              },
                              "required": ["path", "diff", "changes"],
                              "additionalProperties": {}
                            }
                          }
                        },
                        "required": ["status", "repositories"],
                        "additionalProperties": {}
                      },
                      {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": ["not_found", "invalid_path"]
                          }
                        },
                        "required": ["status"],
                        "additionalProperties": {}
                      }
                    ]
                  }
                },
                "required": ["status", "value"],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["pending", "unavailable", "expired", "missing"]
                  }
                },
                "required": ["status"],
                "additionalProperties": {}
              }
            ]
          },
          "fileDiff.input": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": ["repository", "path"],
            "additionalProperties": false
          },
          "fileDiff.output": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "ready"
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "const": "read"
                          },
                          "diff": {
                            "type": "object",
                            "properties": {
                              "path": {
                                "type": "string"
                              },
                              "originalPath": {
                                "type": "string"
                              },
                              "status": {
                                "type": "string",
                                "enum": [
                                  "added",
                                  "modified",
                                  "deleted",
                                  "renamed",
                                  "untracked",
                                  "conflicted"
                                ]
                              },
                              "staged": {
                                "type": "boolean"
                              },
                              "unstaged": {
                                "type": "boolean"
                              },
                              "indexStatus": {
                                "type": "string"
                              },
                              "worktreeStatus": {
                                "type": "string"
                              },
                              "repository": {
                                "type": "string"
                              },
                              "original": {
                                "type": "string"
                              },
                              "modified": {
                                "type": "string"
                              },
                              "binary": {
                                "type": "boolean"
                              },
                              "truncated": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "path",
                              "status",
                              "staged",
                              "unstaged",
                              "indexStatus",
                              "worktreeStatus",
                              "repository",
                              "original",
                              "modified",
                              "binary",
                              "truncated"
                            ],
                            "additionalProperties": {}
                          }
                        },
                        "required": ["status", "diff"],
                        "additionalProperties": {}
                      },
                      {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": ["not_found", "invalid_path"]
                          }
                        },
                        "required": ["status"],
                        "additionalProperties": {}
                      }
                    ]
                  }
                },
                "required": ["status", "value"],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["pending", "unavailable", "expired", "missing"]
                  }
                },
                "required": ["status"],
                "additionalProperties": {}
              }
            ]
          },
          "status.input": {
            "type": "string"
          },
          "status.output": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "ready"
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "repo": {
                            "type": "boolean",
                            "const": false
                          }
                        },
                        "required": ["repo"],
                        "additionalProperties": {}
                      },
                      {
                        "type": "object",
                        "properties": {
                          "repo": {
                            "type": "boolean",
                            "const": true
                          },
                          "root": {
                            "type": "string"
                          },
                          "head": {
                            "type": "string"
                          },
                          "detached": {
                            "type": "boolean"
                          },
                          "unborn": {
                            "type": "boolean"
                          },
                          "upstream": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "ahead": {
                            "type": "number"
                          },
                          "behind": {
                            "type": "number"
                          },
                          "dirty": {
                            "type": "object",
                            "properties": {
                              "staged": {
                                "type": "number"
                              },
                              "modified": {
                                "type": "number"
                              },
                              "untracked": {
                                "type": "number"
                              }
                            },
                            "required": ["staged", "modified", "untracked"],
                            "additionalProperties": {}
                          },
                          "conflicted": {
                            "type": "number"
                          },
                          "operation": {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": [
                                  "merge",
                                  "rebase",
                                  "cherry-pick",
                                  "revert",
                                  "bisect"
                                ]
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "worktree": {
                            "type": "boolean"
                          },
                          "shallow": {
                            "type": "boolean"
                          },
                          "stash": {
                            "type": "number"
                          },
                          "submodules": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "repo",
                          "root",
                          "head",
                          "detached",
                          "unborn",
                          "upstream",
                          "ahead",
                          "behind",
                          "dirty",
                          "conflicted",
                          "operation",
                          "worktree",
                          "shallow",
                          "stash",
                          "submodules"
                        ],
                        "additionalProperties": {}
                      }
                    ]
                  }
                },
                "required": ["status", "value"],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["missing", "inactive", "pending"]
                  }
                },
                "required": ["status"],
                "additionalProperties": {}
              }
            ]
          },
          "switchBranch.input": {
            "type": "object",
            "properties": {
              "threadId": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "cwd": {
                "type": "string"
              }
            },
            "required": ["threadId", "branch", "cwd"],
            "additionalProperties": false
          },
          "switchBranch.output": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "ready"
                  },
                  "value": {
                    "type": "object",
                    "properties": {
                      "branches": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "current": {
                              "type": "boolean"
                            },
                            "commit": {
                              "type": "string"
                            },
                            "subject": {
                              "type": "string"
                            },
                            "worktree": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "name",
                            "current",
                            "commit",
                            "subject",
                            "worktree"
                          ],
                          "additionalProperties": {}
                        }
                      },
                      "blocked": {
                        "type": "string"
                      }
                    },
                    "required": ["branches"],
                    "additionalProperties": {}
                  }
                },
                "required": ["status", "value"],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "refused"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": ["status", "message"],
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["missing", "inactive", "pending"]
                  }
                },
                "required": ["status"],
                "additionalProperties": {}
              }
            ]
          }
        }
      }
    },
    {
      "id": "git.changes/v1",
      "version": "1.0.0",
      "kind": "service",
      "environment": "client",
      "cardinality": "one",
      "local": true,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "doric:contract/git.changes/v1",
        "x-doric-kind": "service",
        "$defs": {
          "observe.input": {
            "x-doric-local": true
          },
          "observe.output": {
            "x-doric-local": "disposable"
          }
        }
      }
    },
    {
      "id": "git.open-comparison/v1",
      "version": "1.0.0",
      "kind": "command",
      "environment": "client",
      "cardinality": "one",
      "local": false,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "doric:contract/git.open-comparison/v1",
        "x-doric-kind": "command",
        "$defs": {
          "input": {
            "type": "object",
            "properties": {
              "projectId": {
                "type": "string"
              },
              "repository": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": ["projectId", "repository", "path"],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
