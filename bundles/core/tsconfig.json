      "path": "../../packages/bundle"
    },
    {
      "path": "../../packages/tool"
    },
    {
      "path": "../codex"
    },
    {
      "path": "../openai"
    },
    {
      "path": "../openrouter"
    },
    {
      "path": "../../packages/llms"
    },
    {
      "path": "../../packages/desktop-ui"
    },
    {
      "path": "../../packages/desktop-client"
    }
  ],
  "exclude": ["src/desktop/**", "src/client/**"]
}
