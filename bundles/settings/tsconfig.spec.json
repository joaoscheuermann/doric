{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "outDir": "dist-tests",
    "rootDir": ".",
    "tsBuildInfoFile": "dist-tests/tsconfig.spec.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "src/client/api/settings-api.ts",
    "src/client/domain/*.ts",
    "src/client/services/*.ts",
    "tests/*.ts",
    "tests/support/**/*.ts"
  ],
  "references": [
    {
      "path": "../../packages/bundle/tsconfig.lib.json"
    }
  ]
}
