{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "doric",
  "projectType": "application",
  "sourceRoot": "agents/doric/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["^build", "build-bundles"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "outputPath": "agents/doric/dist",
        "main": "agents/doric/src/index.ts",
        "tsConfig": "agents/doric/tsconfig.lib.json",
        "clean": false
      }
    },
    "build-bundles": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist/bundles"],
      "options": {
        "commands": [
          "nx run-many --target=build --projects=bundle-postgres,bundle-core,bundle-files,bundle-git,bundle-threads,bundle-runtime,bundle-terminal,bundle-direct,bundle-models-adapter,bundle-sandbox-adapter,bundle-transport --parallel=3",
          "node packages/bundle/dist/build/cli.js stage agents/doric/dist/bundles bundles/postgres bundles/core bundles/files bundles/git bundles/threads bundles/runtime bundles/direct bundles/models-adapter bundles/sandbox-adapter"
        ],
        "parallel": false
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate deploy --config agents/doric/prisma.config.ts"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node agents/doric/dist/src/index.js"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "continuous": true,
      "options": {
        "command": "node agents/doric/dist/src/index.js"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "build-bundles"],
      "cache": false,
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "tsc -p agents/doric/tsconfig.spec.json",
          "node --test agents/doric/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": []
}
