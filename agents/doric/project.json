{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "doric",
  "projectType": "application",
  "sourceRoot": "agents/doric/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["^build", "build-bundles"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "outputPath": "agents/doric/dist",
        "main": "agents/doric/src/index.ts",
        "tsConfig": "agents/doric/tsconfig.lib.json",
        "clean": false
      }
    },
    "build-bundles": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist/bundles"],
      "options": {
        "commands": [
          "node packages/bundle/dist/build/cli.js stage agents/doric/dist/bundles bundles/postgres bundles/core bundles/files bundles/git bundles/threads bundles/runtime bundles/direct bundles/openai bundles/openrouter bundles/codex bundles/docker bundles/firecracker bundles/web bundles/terminal bundles/usage bundles/resources bundles/notifications bundles/layout bundles/settings bundles/chat bundles/history"
        ],
        "parallel": false
      },
      "dependsOn": [
        {
          "target": "build",
          "projects": [
            "bundle-postgres",
            "bundle-core",
            "bundle-files",
            "bundle-git",
            "bundle-threads",
            "bundle-runtime",
            "bundle-direct",
            "bundle-openai",
            "bundle-openrouter",
            "bundle-codex",
            "bundle-docker",
            "bundle-firecracker",
            "bundle-web",
            "bundle-terminal",
            "bundle-usage",
            "bundle-resources",
            "bundle-notifications",
            "bundle-layout",
            "bundle-settings",
            "bundle-chat",
            "bundle-history",
            "bundle-transport"
          ]
        }
      ],
      "cache": false
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate deploy --config agents/doric/prisma.config.ts"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node agents/doric/dist/src/index.js"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "continuous": true,
      "options": {
        "command": "node agents/doric/dist/src/index.js"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "build"],
      "cache": false,
      "outputs": ["{projectRoot}/dist-tests"],
      "options": {
        "commands": [
          "tsc -p agents/doric/tsconfig.spec.json",
          "node --test agents/doric/dist-tests/tests/*.test.js"
        ],
        "parallel": false
      }
    }
  },
  "tags": []
}
