# Local values for the Docker deploy (see "Docker deploy" in README.md).
# Copy this file to agents/doric/.env, which is git-ignored, and fill it in.
# Names only: real secrets never belong in tracked files.

DORIC_POSTGRES_USER=doric
DORIC_POSTGRES_DB=doric
DORIC_POSTGRES_PASSWORD=
# Encrypts stored credential secrets: 32 base64-encoded bytes. Required once any
# credential holds a secret. Generate one with: openssl rand -base64 32
DORIC_CREDENTIAL_KEY=

# Optional: publish PostgreSQL on another host port (default 5432).
# DORIC_POSTGRES_PORT=5432

# Native host runs: a path on the PostgreSQL filesystem (default: current directory).
# Compose sets its own read-only PostgreSQL volume mount for this measurement.
# DORIC_STORAGE_PATH=/path/to/postgresql
